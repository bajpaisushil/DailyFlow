<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Shows the alarm over the lock screen. This is the whole point of the module: a
       notification cannot take over the screen, and a reminder you must not sleep through
       has to. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- setAlarmClock is the only variant Android treats as a user-visible alarm, so it
       survives Doze and battery optimisation. It needs one of these. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- singleTask so a second alarm reuses the same screen instead of stacking; excluded
         from recents so a dismissed alarm cannot be resurrected from the task switcher. -->
    <activity
      android:name="app.dailyflow.alarm.AlarmActivity"
      android:exported="false"
      android:launchMode="singleTask"
      android:excludeFromRecents="true"
      android:showOnLockScreen="true"
      android:turnScreenOn="true"
      android:screenOrientation="portrait"
      android:theme="@style/Theme.AppCompat.NoActionBar" />

    <receiver
      android:name="app.dailyflow.alarm.AlarmReceiver"
      android:exported="false" />

    <!-- The Stop button on every alarm notification. A broadcast rather than a service start,
         because starting a service is what Android refuses to an app in the background — and
         someone silencing an alarm from the notification shade is always in the background. -->
    <receiver
      android:name="app.dailyflow.alarm.AlarmStopReceiver"
      android:exported="false" />

    <service
      android:name="app.dailyflow.alarm.AlarmService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
